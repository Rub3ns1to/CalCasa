# Copia este fichero como .env y no lo subas al repositorio (ya está en .gitignore).
OPENROUTER_API_KEY=sk-or-...

# OpenAI (compatible con OpenRouter por defecto o API directa de OpenAI)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=${OPENROUTER_API_KEY}
OPENAI_MODEL=openai/gpt-5.4-mini

# Anthropic / Claude (compatible con OpenRouter por defecto o API directa de Anthropic)
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_API_KEY=${OPENROUTER_API_KEY}
ANTHROPIC_MODEL=anthropic/claude-haiku-4.5

# Gemini (vía OpenRouter si GEMINI_API_KEY está vacío, o API nativa de Google si se rellena)
GEMINI_MODEL=google/gemini-3.8-flash
GEMINI_API_KEY=

# Opciones de la aplicación (auto | gemini | openrouter | openai | anthropic)
VISION_PROVIDER=auto
MAX_IMAGES=10
MAX_VISUAL_ADJUSTMENT_PCT=15.0
ALLOW_FALLBACK_ON_ERROR=true
LOG_LEVEL=INFO
